<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DotNetEnv" Version="3.2.0" />
		<PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
		<PackageReference Include="libdave" Version="1.1.1.7" />
		<PackageReference Include="libsodium" Version="1.0.22" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0-preview.4.26230.115" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-preview.4.26230.115" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="MongoDB.Driver" Version="3.9.0" />
		<PackageReference Include="NetCord" Version="1.0.0-beta.2" />
		<PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.2" />
		<PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.2" />
		<PackageReference Include="NetCord.Services" Version="1.0.0-beta.2" />
		<PackageReference Include="OpusSharp.Natives" Version="1.6.1.3" />
		<PackageReference Include="SoundTouch.Net" Version="2.3.2" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="runtimes\licenses\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

		<!-- This runs only during publish. -->
		<Content Include="runtimes\$(RuntimeIdentifier)\native\**\*" Condition="'$(RuntimeIdentifier)' != ''" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

		<!-- This runs only on debug builds. -->
		<Content Include="runtimes\**\native\**\*" Condition="'$(Configuration)' == 'Debug' and '$(RuntimeIdentifier)' == ''" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<!-- Copy .env to output on debug builds to prevent the app from crashing and so that DotNetEnv can read it. -->
		<None Update=".env" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\.gitignore">
			<Link>.gitignore</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="runtimes\linux-arm64\native\" />
	  <Folder Include="runtimes\linux-x64\native\" />
	  <Folder Include="runtimes\win-x64\native\" />
	</ItemGroup>
</Project>
