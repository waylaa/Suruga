<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DotNetEnv" Version="3.2.0" />
		<PackageReference Include="libdave" Version="1.1.1.7" />
		<PackageReference Include="libsodium" Version="1.0.22" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0-preview.7.26381.103" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-preview.7.26381.103" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
		<PackageReference Include="MongoDB.Driver" Version="3.11.1" />
		<PackageReference Include="NetCord" Version="1.0.0-beta.19" />
		<PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.19" />
		<PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.19" />
		<PackageReference Include="NetCord.Services" Version="1.0.0-beta.19" />
		<PackageReference Include="OpusSharp.Natives" Version="1.6.1.4" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\.dockerignore">
		  <Link>.dockerignore</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\.gitignore">
			<Link>.gitignore</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Suruga.FFmpeg\Suruga.FFmpeg.csproj" />
	  <ProjectReference Include="..\Suruga.PostProcessing\Suruga.PostProcessing.csproj" />
	</ItemGroup>
</Project>
